# Backend Environment Variables
SECRET_KEY=your-super-secret-django-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database: In production on Vercel, use a PostgreSQL connection string (e.g. from Neon.tech or Supabase)
# If left empty, SQLite (db.sqlite3) will be used locally.
# Example: DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret key used for one-click setup / database migration endpoint: /api/setup-db/?secret=...
DEPLOY_SECRET=turfhub-deploy-secret-2026
